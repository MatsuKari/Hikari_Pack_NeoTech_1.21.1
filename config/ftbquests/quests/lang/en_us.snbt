	quest.0087B63E9899007A.quest_desc: ["Este Shape Card é feito para ser utilizado junto com o Builder. Ideal para Construir automaticamente com ele"]
	quest.0087B63E9899007A.quest_subtitle: "Utilidade"
	quest.0106AB27D975BAB0.quest_desc: ["&0Flux&r é o Recurso mais básico do &bFlux Networks&r, é com ele que você consegue fazer os outros componentes do mod. Clique no &0Flux&r nesta quest para ver a receita dele no &7JEI/REI&r, Fabrique alguns deles e faça um &0Bloco de Flux (Veja no REI)&r, com ele você pode fazer Flux onde quiser sem estar na Bedrock"]
	quest.0106AB27D975BAB0.title: "Fabrique 5 Blocos de Flux"
	quest.0111ED82436B21A6.quest_desc: ["O &dGrowth Accelerator&r &cAcelera&r o &eCrescimento de Crops&r do &bMystical Agriculture&r em um raio (&3Veja a Tooltip&r) e quanto melhor o &6Tier&r, &2mais rápido&r as plantas crescem e &1maior&r é o raio. Este é o Tier &22&r"]
	quest.0111ED82436B21A6.quest_subtitle: "Growth Accelerator"
	quest.011E8793FE9AEA02.quest_desc: [
		"Consiga &0Petróleo&r procurando por fontes de &0petróleo&r jorrando na superficie do &9oceano&r. Depois"
		"Fabrique uma &eFuel Refinery&r para &8Refinar o Petróleo&r em &eCombustíve&rl e o Primeiro Passo para deixar a &aTerra&r estará concluído"
	]
	quest.011E8793FE9AEA02.title: "Combustível - Rumo ao Espaço Parte I"
	quest.017B4E4AFCD9379C.quest_desc: ["Para criar &2Velas&r, primeiro é necessário fabricar um &bCutelo&r, com ele você deve matar alguns mobs pacíficos como &dovelhas, porcos, cavalos, etc&r. para conseguir um pouco de &3Sebo&r. Junte &3Sebo&r + &bLinha&r numa &9Crafting Grid&r para criar &2Velas&r. Elas são essenciais para os &0Rituais do Occultism&r"]
	quest.0281F6E4CCE938F7.quest_desc: ["Pegue seu melhor equipamento, suas melhores Gemas e que começe a Festa"]
	quest.02B7DBFB1D2BB53F.quest_desc: [
		"Área de Construção da Mesa de Encantamentos Automática:"
		"12 Blocos de Largura x 19 Blocos de Comprimento x 4 Blocos de Altura "
